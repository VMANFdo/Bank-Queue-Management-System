# Environment Variables — BQMS
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Connection string for Drizzle ORM (use Transaction mode / PgBouncer pooled URL)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true

# Supabase project URL (found in Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon / public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — server-side ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Cron ────────────────────────────────────────────────────────────────────
# Secret token Vercel sends in x-vercel-cron header; also used in local testing
CRON_SECRET=replace-with-a-long-random-secret

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
